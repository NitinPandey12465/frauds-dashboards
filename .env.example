# PostgreSQL connection string (required).
#
# Local development:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production (Vercel) — use a hosted Postgres (Neon / Supabase / Vercel Postgres).
# Their connection strings include ?sslmode=require and look like:
#   DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
#
# The app self-provisions: on first request it creates the tables/indexes and
# seeds ~2,200 transactions, so no migrations are needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
